# ==============================================================================
# Eleven Nation - Environment Variables Configuration
# ==============================================================================

# Supabase Project URL (Client & Server)
# Found in Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Public Key (Client & Server)
# Used for public client-side read operations and authentication
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Service Role Key (Backend Server Only)
# REQUIRED FOR PRODUCTION ORDER PROCESSING & ATOMIC RPC IN VERCEL
# Never expose this key to client-side code or commit it to version control
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Server Port (Defaults to 3000 locally, dynamically provided on Vercel)
PORT=3000
